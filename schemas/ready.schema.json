{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "USSEG ready1.0",
  "required": [
    "schema_version",
    "job_id",
    "metadata_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "metadata_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
